# OpsMesh environment template - copy to .env and fill in real values.

# --- Supabase (managed PostgreSQL + REST/Realtime) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key: full admin access, backend only - keep out of git and out of the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PostgreSQL ---
# Format: postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
# URL-encode special chars in the password (e.g. @ -> %40) or use a dedicated
# PgBouncer/session-pooler URL from Supabase dashboard (Connect -> Session pooler).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true

# --- JWT ---
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EVENTS_QUEUE=opsmesh.events
RABBITMQ_RETRY_QUEUE=opsmesh.events.retry
RABBITMQ_DLQ=opsmesh.events.dlq

# --- Rate limiting ---
RATE_LIMIT_EVENTS_PER_MINUTE=1000
RATE_LIMIT_API_PER_MINUTE=120

# --- Workers ---
ESCALATION_CHECK_INTERVAL_MS=15000
HEALTH_CHECK_INTERVAL_MS=30000

# --- AI assistant (optional) ---
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=opsmesh@localhost
SLACK_WEBHOOK_URL=